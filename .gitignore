# Go binary output goes to the team-level bin/ on $PATH
/bin/
# Stray builds at the project root (e.g. `go build` without -o)
/fwqual
/qac
/genrlccfixture

# SQLite files (data, WAL, shared memory)
fwqual.db
fwqual.db-shm
fwqual.db-wal
qac.db
qac.db-shm
qac.db-wal

# Screenshots from iteration sessions — not part of source
/tab*.png

# Frontend artifacts
web/node_modules/
web/dist/*
!web/dist/.gitkeep
!web/dist/index.html

# Local-dev creds — never commit (pr-security scans for secrets). .env.example is tracked.
.env
.env.local

# Editor / OS
.DS_Store
*.swp
