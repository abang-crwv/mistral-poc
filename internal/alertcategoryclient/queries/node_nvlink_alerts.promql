max by (cluster_org, cluster, zone, node, severity, alertname) (
  ALERTS{
    alertstate="firing",
    alertname=~"NodeGPUNVLinkDown|NodeGPUNVLinkP2PDown|NodeGPUNVLBadLinkRepeated.*|NodeGPUXID149NVSwitch|NVLinkXIDFatal|GPUNVLinkPrivError|NVL72GPUDriverInconsistentWithRack|NVLMaskErrorPossibleUptimeBug|NVlinkFlowControlErrors|NVlinkCRCErrors|NVlinkReplayErrors|NVlinkRecoveryErrors"
  }
)
* on (node) group_left()
group by (node) (
  baremetal_node_nvlink_domain_info{
    region=~"{region}", zone=~"{zone}", cluster=~"{cluster}",
    nvlink_domain!="", nvlink_domain=~"{nvlink_domain}", node!=""}
)
