max by (cluster_org, cluster, zone, node, severity, alertname) (
  ALERTS{
    alertstate="firing",
    alertname=~"RedfishDown|RedfishDownDpu"
  }
)
* on (node) group_left()
group by (node) (
  baremetal_node_nvlink_domain_info{
    region=~"{region}", zone=~"{zone}", cluster=~"{cluster}",
    nvlink_domain!="", nvlink_domain=~"{nvlink_domain}", node!=""}
)
