group by (node, region, zone, cluster, alertname, alertstate) (
  ALERTS{region=~"{region}", zone=~"{zone}", cluster=~"{cluster}"}
)
* on (node) group_left(slot, deviceslot)
label_replace(
  baremetal_node_nvlink_domain_info{
    region=~"{region}", zone=~"{zone}", cluster=~"{cluster}",
    nvlink_domain!="", nvlink_domain=~"{nvlink_domain}", node!=""},
  "slot", "$1", "deviceslot", ".*node-([0-9]+).*"
)
