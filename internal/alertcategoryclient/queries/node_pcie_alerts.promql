max by (cluster_org, cluster, zone, node, deviceslot, severity, alertname) (
  ALERTS{
    alertstate="firing",
    alertname=~"NodePCIWidth|NodePCISpeedIBH100|NodePCISpeedPLXSMC|NodePCISpeedGPUH100|HardwareErrorInterruptPCIe|GPUPCIEFatalTimeout|IBPCIUnavailable"
  }
)
* on (node) group_left()
group by (node) (
  baremetal_node_nvlink_domain_info{
    region=~"{region}", zone=~"{zone}", cluster=~"{cluster}",
    nvlink_domain!="", nvlink_domain=~"{nvlink_domain}", node!=""}
)
