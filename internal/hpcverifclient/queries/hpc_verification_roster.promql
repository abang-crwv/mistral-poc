kube_node_hpc_verification_last_heartbeat_time
* on(node,cluster,cluster_org) group_left()
  group by (node, cluster, cluster_org) (
    kube_node_labels{label_node_coreweave_cloud_state=~"test|test-fail|production|flcc"}
  )
* on(node,region) group_left()
  group by (node, region) (
    baremetal_node_lifecycle_labels_actual{
      label_flcc_coreweave_com_state!~"rma|broken|triage|debug|dev|hold|onboard|fail|storage",
      label_flcc_coreweave_com_workflow!~"broken-collect|rma.*"
    }
  )
* on(node,region) group_left(rack_name, deviceslot)
  group by (node, region, rack_name, deviceslot) (
    label_replace(
      baremetal_node_physical_topology_labels{label_ds_coreweave_com_physical_topology_rack_name="{rack_name}"},
      "rack_name","$1","label_ds_coreweave_com_physical_topology_rack_name","(.*)"
    )
  )
